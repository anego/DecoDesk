<Window x:Class="DecoDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:DecoDesk.ViewModels"
        mc:Ignorable="d"
        Title="DecoDesk - 設定" Height="680" Width="550"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="icon.ico">
    
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- ラベルスタイル -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0,2" />
        </Style>

        <!-- ボタンのモダンなスタイル（角丸、ホバーエフェクト） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                                <Setter Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC" />
                                <Setter Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="Foreground" Value="#555555" />
                                <Setter Property="BorderBrush" Value="#2D2D2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- プライマリ（目立たせる）ボタンのスタイル -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="BorderBrush" Value="#007ACC" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C97EA" />
                    <Setter Property="BorderBrush" Value="#1C97EA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- テキストボックスのモダンなスタイル（角丸、フォーカス時の青枠） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E1E1E" />
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- ヘッダー部 -->
            <RowDefinition Height="*" />    <!-- 設定コンテンツ -->
            <RowDefinition Height="Auto" /> <!-- ステータスとプログレス -->
            <RowDefinition Height="Auto" /> <!-- 下部ボタン部 -->
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DecoDesk 設定" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="壁紙の自動適用設定と、対象画像の登録インデックス同期を行います。" FontSize="12" Foreground="#888888" Margin="0,4,0,0" />
        </StackPanel>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Margin="0,0,12,0">
            <!-- 複数フォルダ選択 -->
            <Label Content="スキャン対象画像フォルダ (複数登録可能)" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" Height="90" ItemsSource="{Binding TargetDirectories}" SelectedItem="{Binding SelectedDirectory}" Background="#252526" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" IsEnabled="{Binding IsNotIndexing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="4,2" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" VerticalAlignment="Stretch" Margin="8,0,0,0">
                    <Button Content="追加..." Click="AddFolder_Click" IsEnabled="{Binding IsNotIndexing}" Height="28" Width="80" Margin="0,0,0,6" />
                    <Button Content="削除" Command="{Binding RemoveDirectoryCommand}" IsEnabled="{Binding IsNotIndexing}" Height="28" Width="80" />
                </StackPanel>
            </Grid>

            <!-- 2カラム設定 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左カラム: 自動更新 -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="自動壁紙更新" />
                    <CheckBox Content="自動更新を有効にする" IsChecked="{Binding AutoUpdateEnabled}" IsEnabled="{Binding IsNotIndexing}" Foreground="#E0E0E0" Margin="0,8,0,0" />
                </StackPanel>

                <!-- 右カラム: 更新間隔 -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Label Content="更新間隔" />
                    <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedValue="{Binding UpdateIntervalSeconds}" SelectedValuePath="Seconds" DisplayMemberPath="DisplayText" IsEnabled="{Binding IsNotIndexing}" Height="30" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 加工モード選択 -->
            <Label Content="壁紙加工モード" />
            <ComboBox SelectedValue="{Binding ProcessingMode}" SelectedValuePath="Tag" IsEnabled="{Binding IsNotIndexing}" Height="30" Margin="0,0,0,12">
                <ComboBoxItem Content="加工なし (解像度合わせのみ)" Tag="None" />
                <ComboBoxItem Content="ポストカード風 (白いフチ・傾き・ドロップシャドウ)" Tag="Postcard" />
                <ComboBoxItem Content="コルクボード風 (ボードテクスチャ背景・ピン留め)" Tag="Corkboard" />
            </ComboBox>

            <!-- 高度な加工設定（画像数、画像サイズ、配置密度スライダー） -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- 左カラム: 使用画像数 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="画像配置数:" Padding="0,2,4,2" />
                        <TextBlock Text="{Binding WallpaperImageCount, StringFormat={}{0} 枚}" Foreground="#007ACC" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="5" Maximum="20" Value="{Binding WallpaperImageCount}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding IsProcessingModeAdvanced}" Height="30" Margin="0,4,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 中央カラム: 画像サイズ -->
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="画像サイズ:" Padding="0,2,4,2" />
                        <TextBlock Text="{Binding WallpaperImageSize, StringFormat={}{0} px}" Foreground="#007ACC" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="150" Maximum="800" Value="{Binding WallpaperImageSize}" TickFrequency="25" IsSnapToTickEnabled="True" IsEnabled="{Binding IsProcessingModeAdvanced}" Height="30" Margin="0,4,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右カラム: 配置密度 -->
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="配置密度:" Padding="0,2,4,2" />
                        <TextBlock Text="{Binding WallpaperDensityPercent, StringFormat={}{0:0}%}" Foreground="#007ACC" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="50" Maximum="150" Value="{Binding WallpaperDensityPercent}" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding IsProcessingModeAdvanced}" Height="30" Margin="0,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 背景色設定（ポストカード風のみ） -->
            <StackPanel Margin="0,0,0,20" IsEnabled="{Binding IsPostcardModeSelected}">
                <Label Content="ポストカード背景色" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding WallpaperBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="色を選択..." Command="{Binding SelectColorCommand}" Margin="8,0,0,0" Height="30" Padding="12,0" />
                    <Border Grid.Column="2" Width="40" Height="30" Margin="8,0,0,0" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Background="{Binding BackgroundColorBrush}" />
                </Grid>
            </StackPanel>

            <!-- 起動時の設定（スタートアップ、起動時更新、ディレイ） -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左カラム: 起動オプション -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Label Content="システム起動設定" />
                    <CheckBox Content="Windows 起動時に自動で実行する" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding IsNotIndexing}" Foreground="#E0E0E0" Margin="0,6,0,6" />
                    <CheckBox Content="アプリ起動時に壁紙を自動更新する" IsChecked="{Binding UpdateWallpaperOnStartup}" IsEnabled="{Binding IsNotIndexing}" Foreground="#E0E0E0" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 右カラム: 起動遅延秒数 -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="起動後適用ディレイ:" Padding="0,2,4,2" />
                        <TextBlock Text="{Binding StartupDelaySeconds, StringFormat={}{0} 秒}" Foreground="#007ACC" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="0" Maximum="300" Value="{Binding StartupDelaySeconds}" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding IsStartupDelaySliderEnabled}" Height="30" Margin="0,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- インデックス同期エリア -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="画像データベースの同期状況" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="インデックス更新" Command="{Binding StartIndexingCommand}" IsEnabled="{Binding IsNotIndexing}" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                        <Button Content="キャンセル" Command="{Binding CancelIndexingCommand}" IsEnabled="{Binding IsIndexing}" Padding="10,4" FontSize="11" />
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#AAAAAA" Margin="0,8,0,4" TextTrimming="CharacterEllipsis" />
                <ProgressBar Height="10" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Background="#1E1E1E" Foreground="#007ACC" BorderThickness="0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 下部保存・閉じるボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotIndexing}" Style="{StaticResource AccentButton}" Width="80" Height="32" Margin="0,0,8,0" />
            <Button Content="閉じる" Click="Close_Click" Width="80" Height="32" />
        </StackPanel>
    </Grid>
</Window>
